# Firebase config (non strettamente segreti per app mobile, ma evitiamo di esporli
# nel repo pubblico. La vera protezione del backend va fatta con Security Rules,
# App Check e restrizioni API key in Google Cloud Console.)
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/lib/firebase_options.dart
/.firebaserc
